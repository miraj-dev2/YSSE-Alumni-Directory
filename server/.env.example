# YSSE Alumni Directory - Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ysse_alumni_db?schema=public

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=mock-google-client-id-for-development.apps.googleusercontent.com

# JWT Secret - MUST be at least 32 characters
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_demo!

# Comma-separated list of admin emails (case-insensitive)
ADMIN_EMAILS=admin@ysseglobal.org,miraj@ysseglobal.org

# Upload directory for profile photos and temporary CSVs
UPLOAD_DIR=./uploads
